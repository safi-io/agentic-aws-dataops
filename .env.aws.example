# Copy to .env.aws.local and fill in the database and bucket values.
# URL-encode special characters in the database username and password.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@YOUR_RDS_ENDPOINT:5432/dataops?sslmode=require
AWS_REGION=us-east-1
AWS_PROFILE=default
# Leave these blank when using an AWS profile or instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ENDPOINT_URL=

S3_BUCKET_NAME=YOUR_BUCKET
S3_BRONZE_PREFIX=bronze/
S3_SILVER_PREFIX=silver/
S3_QUARANTINE_PREFIX=quarantine/

STRANDS_DECIDER_ENDPOINT=
STRANDS_DECIDER_API_KEY=
DECIDER_MODE=cli
STRANDS_DECIDER_MODEL_ID=StrandsAgents/strands-decider-2B-hobson-v19
DECIDER_TIMEOUT_SECONDS=240

BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
# Optional SNS topic for incident notifications.
ALERT_SNS_TOPIC_ARN=
MAX_NULL_PERCENTAGE=0.15
MAX_RETRY_COUNT=2
