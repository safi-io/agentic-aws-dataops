# Copy to .env.aws.local and supply your authorized database credentials.
# URL-encode special characters in the username/password. Never commit that file.
DATABASE_URL=postgresql+psycopg://dataopsadmin:PASSWORD@agentic-dataops-postgres.c8zes4ouet7m.us-east-1.rds.amazonaws.com:5432/dataops?sslmode=require
AWS_REGION=us-east-1
AWS_PROFILE=default
# Clear emulator credentials when switching from local development to real AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ENDPOINT_URL=

S3_BUCKET_NAME=agentic-dataops-731451715213-us-east-1
S3_BRONZE_PREFIX=bronze/
S3_SILVER_PREFIX=silver/
S3_QUARANTINE_PREFIX=quarantine/

STRANDS_DECIDER_ENDPOINT=
STRANDS_DECIDER_API_KEY=
DECIDER_MODE=cli
STRANDS_DECIDER_MODEL_ID=StrandsAgents/strands-decider-2B-hobson-v19
DECIDER_TIMEOUT_SECONDS=240

BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
# Add an authorized SNS topic only when you intend to notify its subscribers.
ALERT_SNS_TOPIC_ARN=
MAX_NULL_PERCENTAGE=0.15
MAX_RETRY_COUNT=2
