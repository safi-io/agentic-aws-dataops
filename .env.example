# Local development only: PostgreSQL and S3 emulation from docker-compose.yml.
# Copy to .env. These are dummy local credentials, not an AWS account login.
DATABASE_URL=postgresql+psycopg://dataops:dataops@127.0.0.1:5432/dataops
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_SESSION_TOKEN=
AWS_ENDPOINT_URL=http://127.0.0.1:4566

S3_BUCKET_NAME=agentic-dataops-local
S3_BRONZE_PREFIX=bronze/
S3_SILVER_PREFIX=silver/
S3_QUARANTINE_PREFIX=quarantine/

# No Decider call occurs during a normal data-quality job. Leave the remediation
# sensor stopped unless you want the model to download and run on this machine.
DECIDER_MODE=cli
STRANDS_DECIDER_MODEL_ID=StrandsAgents/strands-decider-2B-hobson-v19
DECIDER_TIMEOUT_SECONDS=240
STRANDS_DECIDER_ENDPOINT=
STRANDS_DECIDER_API_KEY=

# LocalStack in this repository provides S3 only; Bedrock is unavailable locally.
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
ALERT_SNS_TOPIC_ARN=
MAX_NULL_PERCENTAGE=0.15
MAX_RETRY_COUNT=2
